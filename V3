  // --- Parser CSV (comillas + CRLF) ---
  function parseCSV(text){
    var rows = [], i = 0, len = text.length, field = '', row = [], inQuotes = false;
    while (i < len) {
      var ch = text.charAt(i);
      if (inQuotes) {
        if (ch === '"') {
          if (i + 1 < len && text.charAt(i + 1) === '"') { field += '"'; i++; } else { inQuotes = false; }
        } else { field += ch; }
      } else {
        if (ch === '"') inQuotes = true;
        else if (ch === ',') { row.push(field); field = ''; }
        else if (ch === '\r') { /* ignore */ }
        else if (ch === '\n') { row.push(field); field = ''; rows.push(row); row = []; }
        else { field += ch; }
      }
      i++;
    }
    row.push(field); rows.push(row);
    return rows.filter(function(r){ return r.join('').trim().length > 0; });
  }

  // --- Lectura robusta del adjunto ---
  function loadAttachmentTextBySysId(sysId){
    var att = new GlideRecord('sys_attachment');
    if (!att.get(sysId)) return null;

    var sa = new GlideSysAttachment();
    try { var s = sa.getContent(att); if (s) return s + ''; } catch (e1) {}
    try { var b = sa.getBytes(att);   if (b) return new Packages.java.lang.String(b, 'UTF-8') + ''; } catch (e2) {}
    try {
      var is = sa.getContentStream(att);
      if (is) {
        var br = new Packages.java.io.BufferedReader(new Packages.java.io.InputStreamReader(is, 'UTF-8'));
        var sb = new Packages.java.lang.StringBuilder(); var line;
        while ((line = br.readLine()) !== null) sb.append(line).append('\n');
        br.close(); return sb.toString() + '';
      }
    } catch (e3) {}
    return null;
  }

  function findAttachmentSysId(){
    if (ATTACHMENT_SYS_ID) return ATTACHMENT_SYS_ID;
    var q = new GlideRecord('sys_attachment');
    q.addQuery('file_name', 'CONTAINS', FILE_NAME_CONTAINS);
    q.addQuery('sys_created_by', gs.getUserName());
    q.orderByDesc('sys_created_on'); q.setLimit(1); q.query();
    if (q.next()) return String(q.getUniqueValue());
    return '';
  }

  // --- Helpers CHG ---
  function findChangeByNumber(number){
    var gr = new GlideRecord('change_request');
    gr.addQuery('number', number);
    gr.setLimit(1);
    gr.query();
    return gr.next() ? gr : null;
  }

