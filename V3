    var setGroup = false;
    if (!cr.getValue('assignment_group')) {
      var groupSysId = toStr(DEFAULT_GROUP_SYS_ID).trim();
      if (!groupSysId && DEFAULT_GROUP_NAME) {
        var g = new GlideRecord('sys_user_group');
        g.addQuery('name', DEFAULT_GROUP_NAME);
        g.setLimit(1); g.query();
        if (g.next()) groupSysId = String(g.getUniqueValue());
      }
      if (groupSysId) { cr.setValue('assignment_group', groupSysId); setGroup = true; }
    }
    if (!cr.getValue('assigned_to') && DEFAULT_ASSIGNED_TO) {
      cr.setValue('assigned_to', DEFAULT_ASSIGNED_TO);
    }
    return setGroup || cr.getValue('assignment_group'); // truthy si quedó con grupo
  }

