
/*
 * Cierre masivo de change_request leyendo un CSV con columnas:
 *   number, close_notes
 * Ejecutar en Scripts - Background (scope global).
 */

(function () {
  // === DATOS A EDITAR =======================================================
  var ATTACHMENT_SYS_ID = '';       // si lo sabes, pégalo aquí
  var FILE_NAME_CONTAINS = 'bulk_chg_close.csv'; // fallback por nombre
  var DRY_RUN = true;               // primero validar en true
  var DEFAULT_CLOSE_NOTES = '';     // opcional si una fila viene sin notas
  // ==========================================================================

  function info(m){ gs.info('[CHG CSV CLOSE] ' + m); }
  function warn(m){ gs.warn('[CHG CSV CLOSE] ' + m); }
  function err (m){ gs.error('[CHG CSV CLOSE] ' + m); }
  function toStr(v){ return (v === null || v === undefined) ? '' : String(v); }

  // --- Parser CSV (comillas + CRLF) ---
  function parseCSV(text){
    var rows = [], i = 0, len = text.length, field = '', row = [], inQuotes = false;
    while (i < len) {
      var ch = text.charAt(i);
      if (inQuotes) {
        if (ch === '"') {
          if (i + 1 < len && text.charAt(i + 1) === '"') { field += '"'; i++; }
          else { inQuotes = false; }
        } else field += ch;
      } else {
        if (ch === '"') inQuotes = true;
        else if (ch === ',') { row.push(field); field = ''; }
        else if (ch === '\r') { /* ignore */ }
        else if (ch === '\n') { row.push(field); field = ''; rows.push(row); row = []; }
        else field += ch;
      }
      i++;
    }
    row.push(field); rows.push(row);
    return rows.filter(function(r){ return r.join('').trim().length > 0; });
  }

  // --- Lectura de adjunto (FIX) ---
  function loadAttachmentTextBySysId(sysId){
    var att = new GlideRecord('sys_attachment');
    if (!att.get(sysId)) return null;

    // Opción segura: getContent devuelve java.lang.String según el tipo
    var sa = new GlideSysAttachment();
    var content = sa.getContent(att); // <--- FIX: pasar el GlideRecord, no el sys_id
    return content ? (content + '') : null;
  }

  function findAttachmentSysId(){
    if (ATTACHMENT_SYS_ID) return ATTACHMENT_SYS_ID;

    var q = new GlideRecord('sys_attachment');
    q.addQuery('file_name', 'CONTAINS', FILE_NAME_CONTAINS);
    q.addQuery('sys_created_by', gs.getUserName());
    q.orderByDesc('sys_created_on');
    q.setLimit(1);
    q.query();
    if (q.next()) return String(q.getUniqueValue());
    return '';
  }

  // --- Utilidades de CHG ---
  function findChangeByNumber(number){
    var gr = new GlideRecord('change_request');
    gr.addQuery('number', number);
    gr.setLimit(1);
    gr.query();
    return gr.next() ? gr : null;
  }

  function closeChange(cr, closeNotes){
    var wasClosed = (cr.getDisplayValue('state') === 'Closed');

    cr.setDisplayValue('state', 'Closed');
    if (closeNotes) cr.setValue('close_notes', closeNotes);
    cr.setValue('closed_at', gs.nowDateTime());
    cr.setValue('closed_by', gs.getUserID());
    cr.work_notes = 'Cierre masivo vía CSV por ' + gs.getUserDisplayName() + '.';

    if (DRY_RUN) {
      info('DRY RUN: ' + cr.getValue('number') + ' '
           + (wasClosed ? '(ya cerrado; se actualizarían notas)' : 'se cerraría')
           + ' | close_notes="' + (closeNotes || '') + '"');
      return true;
    }
    var id = cr.update();
    if (!id) return false;

    info(cr.getValue('number') + ' '
         + (wasClosed ? 'ya estaba cerrado; se actualizaron notas.' : 'cerrado.')
         + (closeNotes ? ' | close_notes aplicado.' : ''));
    return true;
  }

  // --- Carga CSV ---
  var attSysId = findAttachmentSysId();
  if (!attSysId) { err('No se encontró adjunto CSV. Define ATTACHMENT_SYS_ID o ajusta FILE_NAME_CONTAINS.'); return; }
  info('Usando adjunto sys_id=' + attSysId);

  var csv = loadAttachmentTextBySysId(attSysId);
  if (!csv) { err('No se pudo leer el contenido del adjunto (verifica permisos/tipo de archivo).'); return; }

  var rows = parseCSV(csv);
  if (!rows.length) { err('El CSV está vacío.'); return; }

  var headers = rows[0].map(function(h){ return String(h || '').trim().toLowerCase(); });
  var hNumber = headers.indexOf('number');
  var hNotes  = headers.indexOf('close_notes');

  if (hNumber === -1) { err('El CSV debe incluir la columna "number".'); return; }
  if (hNotes  === -1) { warn('No se encontró "close_notes"; se usará DEFAULT_CLOSE_NOTES si aplica.'); }

  var ok=0, fail=0, skip=0;

  for (var r = 1; r < rows.length; r++) {
    var row = rows[r];
    var number = toStr(row[hNumber]).trim();
    var notes  = (hNotes >= 0 ? toStr(row[hNotes]) : '');
    if (!number) { warn('Fila ' + (r+1) + ' sin number; se omite.'); skip++; continue; }
    notes = notes && notes.trim() ? notes.trim() : toStr(DEFAULT_CLOSE_NOTES).trim();

    try {
      var cr = findChangeByNumber(number);
      if (!cr) { warn('Fila ' + (r+1) + ' no encontró change_request number=' + number); fail++; continue; }
      if (closeChange(cr, notes)) ok++; else fail++;
    } catch (e) {
      err('Fila ' + (r+1) + ' error con number=' + number + ' -> ' + e.message);
      fail++;
    }
  }

  info('RESUMEN => OK=' + ok + ' | FAIL=' + fail + ' | SKIP=' + skip + ' | TOTAL_FILAS=' + (rows.length - 1) + ' | DRY_RUN=' + DRY_RUN);
})(); 
